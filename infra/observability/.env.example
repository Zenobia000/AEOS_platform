# 複製為 .env 後修改：cp .env.example .env
# .env 已在 .gitignore 內（infra/observability/.gitignore），不會被推上 git

# Grafana admin 帳號
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

# 對外 URL（給 alert 通知連結回 Grafana 用）
GRAFANA_ROOT_URL=https://obs.example.com

# Prometheus 抓的 AEOS API 目標（內網或 docker-compose 同 network 用容器名）
AEOS_API_TARGET=host.docker.internal:8000

# Slack webhook（OBS-001 §7 告警；Pilot 期可選）
SLACK_WEBHOOK_URL=
