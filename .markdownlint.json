{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
  "default": true,

  "MD003": { "style": "atx" },
  "MD004": { "style": "dash" },
  "MD007": { "indent": 2 },
  "MD009": { "br_spaces": 0, "strict": true },
  "MD010": { "code_blocks": false },
  "MD012": { "maximum": 1 },
  "MD013": false,
  "MD022": { "lines_above": 1, "lines_below": 1 },
  "MD024": { "siblings_only": true },
  "MD025": { "front_matter_title": "" },
  "MD026": { "punctuation": ".,;:!。，；：！" },
  "MD029": { "style": "ordered" },
  "MD030": { "ul_single": 1, "ol_single": 1, "ul_multi": 1, "ol_multi": 1 },
  "MD033": false,
  "MD034": true,
  "MD035": { "style": "---" },
  "MD036": { "punctuation": ".,;:!?。，；：！？" },
  "MD040": { "allowed_languages": [
    "text", "bash", "sh", "shell", "console",
    "python", "py", "javascript", "js", "typescript", "ts", "tsx", "jsx",
    "go", "rust", "java", "csharp", "cs", "ruby", "php",
    "html", "css", "scss",
    "json", "yaml", "yml", "toml", "xml",
    "markdown", "md",
    "sql", "graphql",
    "mermaid", "plantuml",
    "diff", "patch",
    "dockerfile", "makefile", "ini", "env",
    "swift", "kotlin", "c", "cpp",
    "gherkin", "plaintext", "tsx", "jsx",
    "feature"
  ], "language_only": true },
  "MD041": { "level": 1 },
  "MD044": false,
  "MD046": { "style": "fenced" },
  "MD048": { "style": "backtick" },
  "MD049": { "style": "asterisk" },
  "MD050": { "style": "asterisk" },
  "MD055": { "style": "leading_and_trailing" },
  "MD056": true,
  "MD058": true
}
