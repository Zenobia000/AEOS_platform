# MCP 設定（含 API keys，不可提交）
.mcp.json
!.mcp.json.*.example

# Claude Code 個人設定
.claude/settings.local.json

# Claude Code TaskMaster session state（per-clone、per-session 生成，不入 repo）
.claude/taskmaster-data/.session-*
.claude/taskmaster-data/timelog.jsonl
.claude/taskmaster-data/wbs-history.log
.claude/taskmaster-data/project.json
.claude/taskmaster-data/wbs.md

# Claude Code hook logs（per-clone）
.claude/logs/*.log

# Binary executables（跨平台不安全；本專案僅保留 .sh）
*.exe
*.dll
*.dylib
*.so

# Node
node_modules/

# Python
__pycache__/
*.py[cod]
venv/
.env

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# 暫存
tmp/
*.tmp
*.bak
