  "panels": [
    {
      "title": "Auto-reply rate (PILOT-001 §2.1)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(aeos_conversations_total{status=\"auto_resolved\"}[1h])) / sum(rate(aeos_conversations_total[1h]))",
          "legendFormat": "auto-reply"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "title": "Test set pass rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "aeos_test_set_pass_rate",
          "legendFormat": "{{tenant_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      }
    },
    {
      "title": "Active tenants",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "aeos_active_tenants" }]
    },
    {
      "title": "LLM cost (USD, hourly)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(aeos_llm_cost_usd_total[1h]) * 3600)",
          "legendFormat": "{{tenant_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" },
        "overrides": []
      }
    },
    {
      "title": "LLM tokens by tenant (prompt + completion)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tenant_id, type) (rate(aeos_llm_tokens_total[5m]))",
          "legendFormat": "{{tenant_id}} / {{type}}"
        }
      ]
    },
    {
      "title": "KB ingest jobs by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(aeos_kb_ingest_jobs_total[15m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Escalation correctness",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "aeos_escalation_correctness" }],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": []
      }
    }
