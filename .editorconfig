root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = true
# 兩個 trailing space 在 Markdown 表示 hard line break — 不在本專案使用
# 若需換行請另起新段落

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.py]
indent_size = 4

[*.go]
indent_style = tab
