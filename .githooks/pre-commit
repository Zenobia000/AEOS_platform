#!/usr/bin/env bash
#
# pre-commit hook — gates markdown commits against .markdownlint.json
#
# Activated by:  git config core.hooksPath .githooks
# Override one-off with:  git commit --no-verify  (use sparingly; CI may still gate)
#
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 1. Collect staged .md files matching lint scope
mapfile -t MD_FILES < <(
  git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.md$' \
    | grep -Ev '^(node_modules|\.git|VibeCoding_Workflow_Templates/output_style\.md)' \
    || true
)

if [[ ${#MD_FILES[@]} -eq 0 ]]; then
  exit 0
fi

# 2. Ensure markdownlint-cli2 is available
if ! command -v npx >/dev/null 2>&1; then
  echo "❌ pre-commit: npx not found. Install Node.js (nvm install --lts) or commit with --no-verify." >&2
  exit 1
fi

if [[ ! -d node_modules/markdownlint-cli2 ]]; then
  echo "ℹ️  pre-commit: running 'npm install' once to pin markdownlint-cli2..." >&2
  npm install --silent --no-audit --no-fund >/dev/null 2>&1 || {
    echo "❌ npm install failed. Run it manually or commit with --no-verify." >&2
    exit 1
  }
fi

# 3. Run lint on staged files only (faster than full repo scan)
echo "🔍 pre-commit: linting ${#MD_FILES[@]} markdown file(s)..."
if ! npx --no-install markdownlint-cli2 "${MD_FILES[@]}" 2>&1; then
  cat >&2 <<EOF

❌ Markdown lint failed.

Quick fix:
  npx markdownlint-cli2 --fix ${MD_FILES[*]:0:3}${MD_FILES[3]+ ...}

If you need to commit despite this (RARE, e.g. emergency hotfix):
  git commit --no-verify

Lint rule source: .claude/rules/template-formatter.md
EOF
  exit 1
fi

echo "✅ pre-commit: markdown lint passed."
exit 0
